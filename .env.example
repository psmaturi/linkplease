# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── PseudoGram external API ──────────────────────────────────────────────────
# Obtain your key by calling: POST https://pseudogram-api.onrender.com/v1/keygen
# with body: {"email": "your@email.com"}
PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here

# PseudoGram base URL (no trailing slash)
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# ── Webhook signature verification ───────────────────────────────────────────
# The HMAC-SHA256 secret used to verify X-PseudoGram-Signature.
# This is the same value as PSEUDOGRAM_API_KEY (confirmed from spec).
WEBHOOK_SECRET=your_pseudogram_api_key_here

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by docker-compose to set up the DB.
# The DATABASE_URL is assembled from these in docker-compose.yml.
POSTGRES_PASSWORD=linkplease_dev

# If running outside Docker, set the full URL directly:
# DATABASE_URL=postgresql+asyncpg://linkplease:linkplease_dev@localhost:5432/linkplease

# ── Redis ─────────────────────────────────────────────────────────────────────
# If running outside Docker:
# REDIS_URL=redis://localhost:6379/0

# ── App settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Max retries before marking a DM attempt as permanently failed
MAX_DM_RETRIES=5

# Reconciliation interval in seconds (how often to poll DM statuses)
RECONCILIATION_INTERVAL_SECONDS=60
